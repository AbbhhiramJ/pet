{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pet Command",
  "type": "object",
  "required": ["type", "command"],
  "properties": {
    "type": {"const": "command"},
    "command": {
      "type": "string",
      "enum": ["set_expression", "move_servo", "play_sound", "set_led", "sleep", "wake", "heartbeat"]
    },
    "expression": {"type": "string"},
    "servo": {"type": "string"},
    "angle": {"type": "integer", "minimum": 0, "maximum": 180},
    "sound": {"type": "string"},
    "value": {}
  },
  "additionalProperties": false
}
