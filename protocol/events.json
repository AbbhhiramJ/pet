{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pet Event",
  "type": "object",
  "required": [
    "type",
    "event",
    "event_id",
    "device_id",
    "timestamp"
  ],
  "properties": {
    "type": {
      "const": "event"
    },
    "event": {
      "enum": [
        "touch",
        "motion",
        "orientation",
        "voice",
        "heartbeat",
        "battery"
      ]
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "device_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "number"
    },
    "value": {},
    "data": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
